# ==========================================
# Zline AI Environment Configuration Template
# ==========================================

# Database
MONGODB_URI=mongodb://localhost:27017/zline

# NextAuth Authentication
NEXTAUTH_SECRET=your-random-nextauth-secret-key-32-chars-min
NEXTAUTH_URL=http://localhost:3000

# NVIDIA NIM / Nemotron (OpenAI-compatible endpoint)
NVIDIA_API_KEY=nvapi-your-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# Tavily Real-Time Web Search
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Obscura Rust Headless Browser Engine (Chrome DevTools Protocol)
# For local Docker: http://127.0.0.1:9222
# For Docker Compose network: http://obscura:9222
# For private remote server: http://private-host:9222 or ws://private-host:9222/devtools/browser/...
OBSCURA_CDP_URL=http://127.0.0.1:9222

# Web Push Notifications (Optional)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@zline.app

# Google Site Verification (Search Console)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

